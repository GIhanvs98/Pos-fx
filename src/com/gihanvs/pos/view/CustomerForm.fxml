<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gihanvs.pos.controller.CustomerFormController">
   <children>
      <Button layoutX="22.0" layoutY="14.0" mnemonicParsing="false" onAction="#backToHomeOnAction" text="&lt;- Back">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Label layoutX="100.0" layoutY="13.0" text="Customer  Management" textFill="#d30d0d">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button layoutX="460.0" layoutY="14.0" mnemonicParsing="false" onAction="#newCustomerOnAction" prefHeight="27.0" prefWidth="129.0" style="-fx-background-color: #2980b9;" text="+ New Customer" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Separator layoutY="51.0" prefHeight="0.0" prefWidth="600.0" />
      <TextField fx:id="txtName" layoutX="14.0" layoutY="65.0" prefHeight="27.0" prefWidth="164.0" promptText="Customer Name" />
      <TextField fx:id="txtSalary" layoutX="194.0" layoutY="65.0" prefHeight="27.0" prefWidth="109.0" promptText="Salary" />
      <TextField fx:id="txtAddress" layoutX="312.0" layoutY="65.0" prefHeight="27.0" prefWidth="135.0" promptText="Address" />
      <Button fx:id="btnSave" layoutX="460.0" layoutY="65.0" mnemonicParsing="false" onAction="#saveOnAction" prefHeight="27.0" prefWidth="129.0" style="-fx-background-color: #2980b9;" text="Save Customer" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <TextField fx:id="txtSearch" layoutX="18.0" layoutY="114.0" prefHeight="27.0" prefWidth="459.0" promptText="Search Here" />
      <TableView fx:id="tblCustomer" layoutX="18.0" layoutY="163.0" prefHeight="200.0" prefWidth="570.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="id" />
          <TableColumn fx:id="colName" prefWidth="75.0" text="name" />
            <TableColumn fx:id="colSalary" prefWidth="168.0" text="Salary" />
            <TableColumn fx:id="colAddress" prefWidth="152.0" text="Address" />
            <TableColumn fx:id="colOption" prefWidth="99.0" text="Option" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
